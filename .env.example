# 复制为 .env 后按需修改；所有项都有安全默认值，不改也能启动。
# cp .env.example .env      (Windows: copy .env.example .env)

# ---- 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
# 同源部署时保持 *；若前后端分离，填前端域名（逗号分隔）
CORS_ORIGINS=*

# ---- 翻译降级链（按序尝试，第一个成功即返回）----
# argos = 离线 MIT 引擎（需先装语言包）；libre = LibreTranslate HTTP；free = MyMemory 匿名免费
TRANSLATE_CHAIN=argos,libre,free
SOURCE_LANG=zh
TARGET_LANG=ko
MAX_TEXT_LENGTH=2000
MAX_TTS_LENGTH=800
REQUEST_TIMEOUT=20

# 可选：自托管 LibreTranslate（AGPL-3.0 服务边界）或填自己的公共实例
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_API_KEY=
# 可选：填写邮箱可提升 MyMemory 匿名配额
MYMEMORY_EMAIL=

# ---- 发音 ----
# edge = 服务端神经语音；melo = 完全离线（默认关闭，需 MELOTTS_ENABLED=true）
TTS_PROVIDER=edge
DEFAULT_VOICE=ko-KR-SunHiNeural
KO_VOICES=ko-KR-SunHiNeural,ko-KR-InJoonNeural,ko-KR-HyunsuNeural,ko-KR-SoonBokNeural
RATE_MIN=0.5
RATE_MAX=1.5
RATE_DEFAULT=1.0

# ---- 缓存（进程内 LRU，不引入数据库）----
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=256
CACHE_TTL_SECONDS=86400
CACHE_MAX_BYTES=33554432

# ---- 路径（一般无需修改）----
# STATIC_DIR=/app/web/dist
# ARGOS_PACKAGES_DIR=
